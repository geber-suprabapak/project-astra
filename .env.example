# Required
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=skanida-bff

# School Tenant
TENANT_KEY=school-slug
TENANT_NAME=Nama Sekolah
BUSINESS_TIMEZONE=Asia/Jakarta

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081

# PostgreSQL Database (PgBouncer / direct)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astra
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_MS=5000

# S3-Compatible Object Storage (MinIO, Ceph, Garage, AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_AVATARS=avatars
S3_BUCKET_PERMITS=perizinan
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://storage.school.example
STORAGE_UPLOAD_TIMEOUT_MS=15000

# OIDC / Logto Authentication
# Provide ONE of: OIDC_JWKS_URL or OIDC_JWT_SECRET
OIDC_JWT_SECRET=your-jwt-secret-min-32-chars
# OIDC_JWKS_URL=http://localhost:3001/oidc/jwks
OIDC_ISSUER=http://localhost:3001/oidc
OIDC_AUDIENCE=https://api.example.test/skanida
#
# Set OIDC_AUDIENCE to the registered Logto API resource indicator.
# Astra authorizes access-token scopes from Logto global RBAC; privileged
# sessions require mobile:access; privileged sessions additionally require
# admin:read. Do not rely on custom role or password claims.

# Optional Logto Management API (for user admin operations)
# LOGTO_ENDPOINT=http://localhost:3001
# LOGTO_APP_ID=your-m2m-app-id
# LOGTO_APP_SECRET=your-m2m-app-secret

# Auth Helper (scripts/get-jwt-token.ts)
# AUTH_USER_ID=test-student-1
# AUTH_EMAIL=student@sekolah.sch.id

# Robin (Face Recognition API)
ROBIN_BASE_URL=http://robin:8000
ROBIN_READY_TIMEOUT_MS=3000
ROBIN_IDENTIFY_TIMEOUT_MS=30000
ROBIN_ENROLL_TIMEOUT_MS=60000
ROBIN_ENROLL_STATUS_TIMEOUT_MS=5000
ROBIN_SERVICE_TOKEN=replace-with-rotated-private-service-token

# Redis Rate Limiting
# Required in production. Optional in local/test; falls back to in-memory store when omitted.
REDIS_URL=
REDIS_KEY_PREFIX=astra:ratelimit

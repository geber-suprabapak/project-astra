# Host-side file: /secure/skanida/astra.env. Never commit the populated file.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=skanida-bff

TENANT_KEY=replace-with-school-key
TENANT_NAME=replace-with-school-name
BUSINESS_TIMEZONE=Asia/Jakarta
CORS_ALLOWED_ORIGINS=https://app.school.example,https://admin.school.example

DATABASE_URL=postgresql://skanida:replace-with-target-db-password@pgbouncer:6432/skanida
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_MS=5000

S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=replace-with-scoped-garage-key
S3_SECRET_ACCESS_KEY=replace-with-scoped-garage-secret
S3_BUCKET_AVATARS=avatars
S3_BUCKET_PERMITS=perizinan
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=https://storage.school.example
STORAGE_UPLOAD_TIMEOUT_MS=15000

# Issuer is the public HTTPS URL; Astra fetches public keys from Logto internally.
OIDC_ISSUER=https://auth.school.example/oidc
OIDC_JWKS_URL=http://logto:3001/oidc/jwks
OIDC_AUDIENCE=authenticated
LOGTO_ENDPOINT=http://logto:3001
LOGTO_APP_ID=replace-after-logto-m2m-setup
LOGTO_APP_SECRET=replace-after-logto-m2m-setup

# One-week legacy mobile bridge. Set all fields together only during the approved
# bridge window; the expiry must be an explicit RFC 3339 WIB timestamp.
# LEGACY_SUPABASE_JWT_SECRET=copy-securely-from-legacy-auth
# LEGACY_SUPABASE_JWT_ISSUER=https://prod-db1.hyacine.my.id
# LEGACY_SUPABASE_JWT_AUDIENCE=authenticated
# LEGACY_AUTH_BRIDGE_EXPIRES_AT=2026-08-31T23:59:00+07:00

ROBIN_BASE_URL=http://robin:8000
ROBIN_SERVICE_TOKEN=replace-with-the-same-secret-as-robin
ROBIN_READY_TIMEOUT_MS=3000
ROBIN_IDENTIFY_TIMEOUT_MS=30000
ROBIN_ENROLL_TIMEOUT_MS=60000
ROBIN_ENROLL_STATUS_TIMEOUT_MS=5000

REDIS_URL=redis://default:replace-with-target-redis-password@redis:6379
REDIS_KEY_PREFIX=astra:ratelimit

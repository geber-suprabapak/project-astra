{
  "name": "project-astra",
  "version": "0.1.0",
  "description": "Skanida Mobile BFF",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "bun scripts/migrate.ts",
    "auth:token": "bun scripts/get-jwt-token.ts",
    "smoke:staging": "bun scripts/staging-smoke.ts",
    "worker:notifications": "bun src/workers/notifications.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.14",
    "jose": "^5.10.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.9",
    "redis": "^5.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/node": "^20.11.17",
    "@vitest/coverage-v8": "^3.1.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.81.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "ws": "^8.20.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.13"
}
